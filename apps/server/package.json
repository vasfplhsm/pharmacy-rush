{
  "name": "@pharmacy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@colyseus/* --external:express --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@pharmacy/shared": "0.1.0",
    "@colyseus/core": "0.18.10",
    "@colyseus/ws-transport": "0.18.4",
    "@colyseus/schema": "5.0.42",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "esbuild": "0.27.7"
  }
}
